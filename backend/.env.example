# ===================================================================
# LORRY OWNER BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================================
# Copy this file or set these environment variables in your system/shell.
# DO NOT commit actual secrets or passwords to version control.
# ===================================================================

# Application Server Port (Default: 8080)
PORT=8080

# MySQL Database Connection URL
# Replace localhost, 3306, and lorry_fleet_db with your actual database host, port, and schema name
DB_URL=jdbc:mysql://localhost:3306/lorry_fleet_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# MySQL Database Credentials
DB_USERNAME=lorry_app_user
DB_PASSWORD=your_secure_password_here
