# ===================================================================
# BHP LOGISTICS FLEET MANAGER - ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================================
# Copy this file or set these environment variables in your deployment
# platform (e.g. Voroa, Render, Railway, Docker, or system shell).
# DO NOT commit actual secrets or passwords to version control.
# ===================================================================

# Application Server Port (Voroa / cloud platforms inject this automatically)
PORT=8080

# --- PostgreSQL Database Configuration ---
# Option A: Standard Cloud DATABASE_URL URI (Automatically supported by Voroa)
# DATABASE_URL=postgres://voroa_user:your_password@voroa-pg.db.cloud:5432/bhp_logistics_db

# Option B: Standard JDBC URL and Credentials
# DB_URL=jdbc:postgresql://localhost:5432/bhp_logistics_db
# DB_USERNAME=postgres
# DB_PASSWORD=your_secure_password_here

# --- JWT Authentication ---
# Minimum 32 characters (256 bits) for HMAC-SHA256
JWT_SECRET=your_production_secure_jwt_secret_min_32_characters_long!
JWT_EXPIRATION_MS=604800000

# --- Initial Fleet Owner Bootstrap & Safe Password Reset ---
# Automatically provisions the initial OWNER on first startup if no owner exists
INITIAL_OWNER_USERNAME=bhp_owner
INITIAL_OWNER_PASSWORD=your_initial_owner_password
INITIAL_OWNER_FULL_NAME=BHP Logistics Fleet Owner
INITIAL_OWNER_PHONE=9876543210

# Safe One-Time Owner Password Reset:
# Set to 'true' only when you need to reset an existing owner's password to INITIAL_OWNER_PASSWORD.
# Once reset completes, the persistent safeguard prevents accidental resets on restarts.
# After verifying login, set back to 'false' (or remove).
OWNER_PASSWORD_RESET_ENABLED=false

# --- Second Fleet Owner Bootstrap (Optional) ---
# Automatically provisions a second OWNER account on startup if credentials are provided.
# If the username already exists, it is safely skipped without modifying existing accounts.
SECOND_OWNER_USERNAME=
SECOND_OWNER_PASSWORD=
SECOND_OWNER_FULL_NAME=Second Fleet Owner
SECOND_OWNER_PHONE=

# --- Document Storage ---
DOCUMENT_UPLOAD_DIR=uploads/documents
